<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.vipkeys</groupId>
    <artifactId>VipKeys</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>VipKeys</name>
    <description>Redeemable VIP keys with LuckPerms groups, item kits and LlamaEconomy rewards for PowerNukkitX.</description>
    <url>https://github.com/seu-usuario/VipKeys</url>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <!-- Maven Central -->
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2/</url>
        </repository>
        <!-- Repositório oficial do PowerNukkitX -->
        <repository>
            <id>PowerNukkitX-releases</id>
            <name>PowerNukkitX Repository</name>
            <url>https://repo.powernukkitx.org/releases</url>
        </repository>
        <!-- Snapshots do CloudburstMC (netty-transport-nethernet, immutable, etc.) -->
        <repository>
            <id>opencollab-snapshots</id>
            <url>https://repo.opencollab.dev/maven-snapshots/</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
            <releases>
                <enabled>false</enabled>
            </releases>
        </repository>
    </repositories>

    <dependencies>
        <!-- API do PowerNukkitX (fornecida pelo servidor em runtime) -->
        <dependency>
            <groupId>org.powernukkitx</groupId>
            <artifactId>server</artifactId>
            <version>3.0.6-SNAPSHOT</version>
            <scope>provided</scope>
            <exclusions>
                <!-- Dependências transitivas legadas que não são necessárias para compilar o plugin -->
                <exclusion>
                    <groupId>com.nukkitx</groupId>
                    <artifactId>natives</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.cloudburstmc.netty</groupId>
                    <artifactId>netty-transport-nethernet</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.cloudburstmc.netty</groupId>
                    <artifactId>netty-external-signaling</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>dev.opencollab</groupId>
                    <artifactId>libdatachannel-java-arch-detect</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.cloudburstmc.math</groupId>
                    <artifactId>immutable</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.cloudburstmc.netty</groupId>
                    <artifactId>netty-transport-raknet</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- API do LuckPerms (fornecida pelo LuckPerms em runtime) -->
        <dependency>
            <groupId>net.luckperms</groupId>
            <artifactId>api</artifactId>
            <version>5.4</version>
            <scope>provided</scope>
        </dependency>

        <!-- API do LlamaEconomy (fornecida pelo LlamaEconomy em runtime) -->
        <dependency>
            <groupId>net.lldv.llamaeconomy</groupId>
            <artifactId>LlamaEconomy</artifactId>
            <version>1.0.2</version>
            <scope>provided</scope>
        </dependency>

        <!-- HikariCP: pool de conexões para o MySQL. -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.1.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>VipKeys</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
