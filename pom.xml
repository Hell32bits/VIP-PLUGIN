<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.vipkeys</groupId>
    <artifactId>VipKeys</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>VipKeys</name>
    <description>Redeemable VIP keys with LuckPerms groups, item kits and LlamaEconomy rewards for PowerNukkitX.</description>
    <url>https://github.com/seu-usuario/VipKeys</url>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <!-- Maven Central -->
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2/</url>
        </repository>
        <!-- Repositório oficial do PowerNukkitX -->
        <repository>
            <id>PowerNukkitX-releases</id>
            <name>PowerNukkitX Repository</name>
            <url>https://repo.powernukkitx.org/releases</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- API do PowerNukkitX (fornecida pelo servidor em runtime) -->
        <!-- Versão da API: 3.0.6 -->
        <dependency>
            <groupId>org.powernukkitx</groupId>
            <artifactId>server</artifactId>
            <version>3.0.6</version>
            <scope>provided</scope>
        </dependency>

        <!-- API do LuckPerms (fornecida pelo LuckPerms em runtime) -->
        <dependency>
            <groupId>net.luckperms</groupId>
            <artifactId>api</artifactId>
            <version>5.4</version>
            <scope>provided</scope>
        </dependency>

        <!-- API do LlamaEconomy (fornecida pelo LlamaEconomy em runtime) -->
        <dependency>
            <groupId>net.lldv.llamaeconomy</groupId>
            <artifactId>LlamaEconomy</artifactId>
            <version>1.0.2</version>
            <scope>provided</scope>
        </dependency>

        <!-- HikariCP: pool de conexões para o MySQL.
             O PowerNukkitX já inclui HikariCP + SLF4J no classpath do servidor,
             por isso usamos scope "provided".
             Se o seu servidor NÃO incluir o HikariCP, mude o scope para "compile"
             e adicione o maven-shade-plugin para embuti-lo no JAR (veja o README). -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.1.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>VipKeys</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
